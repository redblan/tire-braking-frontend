{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BrakePath",
  "version": "0.1.0",
  "identifier": "ru.bmstu.iu5.brakepath",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BrakePath",
        "width": 1120,
        "height": 780,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 560,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
